# Copy to .env (git-ignored) and `set -a; source .env; set +a` before `make run`.
GITHUB_CLIENT_ID=Iv1....
GITHUB_CLIENT_SECRET=
# Shared secret between the web server and agent-service. Generate with:
#   openssl rand -hex 32
AGENT_SERVICE_TOKEN=
GEMINI_API_KEY=
# Only for agent-cli against GitHub repos (installation-level access):
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_PATH=./github-app.pem
# GITHUB_INSTALLATION_ID=12345678
