# Copy to config.yaml (git-ignored). ${VAR} values are read from the
# environment, e.g. from a local .env file (see .env.example).

web:                         # the primary interface: python -m slackagent.web
  host: 127.0.0.1            # loopback only
  port: 8765
  base_url: http://localhost:8765   # GitHub App "Callback URL" = <base_url>/auth/callback
  session_hours: 8
  encryption_key_file: ./data/web_secret.key   # created on first run (0600)

github:                      # one GitHub App (Contents + Pull requests: read & write)
  client_id: ${GITHUB_CLIENT_ID}           # web page sign-in (user-to-server tokens)
  client_secret: ${GITHUB_CLIENT_SECRET}
  # Only needed for the optional Slack bot (acts as the App installation):
  app_id: ${GITHUB_APP_ID}
  private_key_path: ${GITHUB_PRIVATE_KEY_PATH}
  installation_id: ${GITHUB_INSTALLATION_ID}
  default_owner: ""

# Optional secondary interface (python -m slackagent.main)
# slack:
#   bot_token: ${SLACK_BOT_TOKEN}
#   app_token: ${SLACK_APP_TOKEN}

ai:
  provider: gemini           # gemini | sim (offline, no API key, no network)
  api_key: ${GEMINI_API_KEY}
  model: gemini-2.5-flash

security:
  allowed_users: []          # Slack user IDs allowed to ask; [] = everyone
  approvers: []              # Slack user IDs allowed to approve; [] = the requester
  allowed_repos: []          # "owner/name" allowlist; [] = any repo the App can access
  protected_paths:
    - ".git/**"
    - ".github/workflows/**"
    - ".env*"
    - "**/secrets/**"
    - "**/*.pem"
    - "**/*.key"
  max_files: 20
  max_changed_lines: 500
  max_file_size_mb: 10
  max_request_chars: 2000
  max_active_tasks_per_user: 2
  agent_network: bridge      # agent container: needs to reach the AI API only
  network_mode: none         # check containers (tests/lint): keep "none"
  scan_secrets: true
  require_approval: true     # human approval of plan AND diff; keep true
  block_on_failed_checks: true
  max_changes_per_hour: 10   # web page proposals per user
  kill_switch_file: ./data/KILL_SWITCH   # touch this file to pause the worker

agent:
  max_tokens: 100000
  planning_budget: 20000
  implementation_budget: 80000
  max_turns: 15
  plan_timeout_s: 300
  implement_timeout_s: 900
  check_timeout_s: 600

database:
  path: ./data/tasks.db

docker:
  image: slack-coding-agent-sandbox:latest
  memory_limit: 1g
  cpu_limit: "1.0"
  pids_limit: 128

worker:
  num_workers: 1
  poll_interval: 3

logging:
  level: INFO

# Per-repository settings. Check commands come only from here (never from the
# model) and run in a network-less container after the agent finishes.
repos:
  myorg/myrepo:
    default_branch: main
    lint_command: "ruff check ."
    test_command: "pytest -q"
    extra_deny_paths:
      - "migrations/**"
