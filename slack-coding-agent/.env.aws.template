# ═══════════════════════════════════════════════════════════════════════════
# Slack Coding Agent — AWS Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# These will be stored in AWS Secrets Manager during deployment

# ──────────────────────────────────────────────────────────────────────────
# AWS Configuration
# ──────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# ──────────────────────────────────────────────────────────────────────────
# Slack App Credentials
# Get these from https://api.slack.com/apps
# ──────────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ──────────────────────────────────────────────────────────────────────────
# GitHub App Credentials
# Create a GitHub App at https://github.com/settings/apps/new
# ──────────────────────────────────────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./github-app-key.pem
GITHUB_INSTALLATION_ID=12345678

# ──────────────────────────────────────────────────────────────────────────
# Google Gemini API
# Get your API key from https://makersuite.google.com/app/apikey
# ──────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyYourApiKeyHere

# ──────────────────────────────────────────────────────────────────────────
# AWS Resources (Auto-populated by CDK after deployment)
# ──────────────────────────────────────────────────────────────────────────
DYNAMODB_TABLE=TaskState
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/slack-agent-task-queue
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:slack-agent-notifications
EVENTBRIDGE_BUS=SlackAgentBus
S3_BUCKET=slack-agent-artifacts-123456789012-us-east-1
STEP_FUNCTION_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:SlackAgentTaskWorkflow

# ──────────────────────────────────────────────────────────────────────────
# Dashboard Configuration (React App)
# ──────────────────────────────────────────────────────────────────────────
REACT_APP_API_URL=https://abcd1234.execute-api.us-east-1.amazonaws.com/prod/
REACT_APP_COGNITO_POOL_ID=us-east-1_XXXXXXXXX
REACT_APP_COGNITO_CLIENT_ID=abcdefghijklmnopqrstuvwxyz
REACT_APP_COGNITO_REGION=us-east-1

# ──────────────────────────────────────────────────────────────────────────
# Optional: Custom Domain (Route53)
# ──────────────────────────────────────────────────────────────────────────
HOSTED_ZONE_ID=Z1234567890ABC
DOMAIN_NAME=slackagent.example.com

# ──────────────────────────────────────────────────────────────────────────
# Optional: Email for SNS Alerts
# ──────────────────────────────────────────────────────────────────────────
ALERT_EMAIL=admin@example.com

# ──────────────────────────────────────────────────────────────────────────
# Deployment Configuration
# ──────────────────────────────────────────────────────────────────────────
DEPLOY_ENV=prod
STACK_PREFIX=SlackAgent

# ──────────────────────────────────────────────────────────────────────────
# HOW TO USE
# ──────────────────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.aws.template .env
# 2. Fill in all values above
# 3. Create secrets in AWS:
#    aws secretsmanager create-secret --name slack-agent/SLACK_BOT_TOKEN \
#      --secret-string "$SLACK_BOT_TOKEN" --region us-east-1
# 4. Run deployment: ./deploy.sh
# ──────────────────────────────────────────────────────────────────────────
