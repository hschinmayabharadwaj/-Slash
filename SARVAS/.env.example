# SARVAS settings. `python3 scripts/setup.py` writes this file for you (as .env,
# mode 0600). Never commit .env. Values here are read by docker compose and by
# `make run` (the Makefile loads .env).

# --- Where people open SARVAS (the GitHub App callback is <this>/auth/callback)
SARVAS_PUBLIC_URL=http://localhost:8765
# 0.0.0.0 only behind an HTTPS reverse proxy
SARVAS_BIND=127.0.0.1
SARVAS_PORT=8765

# --- Who may sign in, and roles (comma-separated GitHub logins).
# Required whenever SARVAS_PUBLIC_URL isn't localhost.
SARVAS_ALLOWED_USERS=
# approve medium-risk plans; requested as PR reviewers
SARVAS_ENGINEERS=
# full audit log, kill switch
SARVAS_ADMINS=
# optional: owner/name,... (empty = wherever the App is installed)
SARVAS_ALLOWED_REPOS=

# --- GitHub App (Settings -> Developer settings -> GitHub Apps)
# Sign-in (OAuth) for everyone:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Installation access for Build tasks (clone private repos, push a branch, open a PR):
GITHUB_APP_ID=
# host path; mounted read-only into the agent
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
# Only for `make run` from source (Compose sets this itself):
# GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

# --- AI model
#   ollama  self-hosted, code never leaves your infrastructure (recommended)
#   gemini  Google's API; Ask/Build send repository code there ONLY if AI_SEND_CODE=true
#   openai  any OpenAI-compatible API (Baseten, Fireworks, vLLM on Modal, ...);
#           set AI_BASE_URL and AI_API_KEY; same AI_SEND_CODE rule as gemini
#   sim     offline placeholder, for trying the workflow
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b
# the bundled server (docker compose --profile local-ai)
OLLAMA_URL=http://ollama:11434
GEMINI_API_KEY=
#   Baseten:   AI_BASE_URL=https://inference.baseten.co/v1
#   Fireworks: AI_BASE_URL=https://api.fireworks.ai/inference/v1
#   Modal:     AI_BASE_URL=https://<workspace>--<app>.modal.run/v1  (your vLLM deployment)
AI_BASE_URL=
AI_API_KEY=
AI_SEND_CODE=false

# --- Storage: everything SARVAS keeps (SQLite DB, repository checkouts and
# index, task workspaces, Ollama models) lives under this host directory.
SARVAS_DATA_DIR=./data

# --- Generated secrets (setup.py creates them)
# Shared secret between web and agent:  openssl rand -hex 32
AGENT_SERVICE_TOKEN=
# Encrypts GitHub tokens at rest:        openssl rand -base64 32
WEB_ENCRYPTION_KEY=
