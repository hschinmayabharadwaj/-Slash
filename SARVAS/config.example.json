{
  "web": {
    "host": "127.0.0.1",
    "port": 8765,
    "baseUrl": "http://localhost:8765",
    "sessionHours": 8,
    "dataDir": "./data",
    "clientDist": "./client/dist"
  },
  "github": {
    "clientId": "${GITHUB_CLIENT_ID}",
    "clientSecret": "${GITHUB_CLIENT_SECRET}",
    "appId": "${GITHUB_APP_ID}",
    "privateKeyPath": "${GITHUB_PRIVATE_KEY_PATH}",
    "installationId": "${GITHUB_INSTALLATION_ID}"
  },
  "agentService": {
    "addr": "127.0.0.1:8766",
    "url": "http://127.0.0.1:8766",
    "token": "${AGENT_SERVICE_TOKEN}",
    "workDir": "./data/work"
  },
  "ai": {
    "provider": "gemini",
    "apiKey": "${GEMINI_API_KEY}",
    "model": "gemini-2.5-flash",
    "baseUrl": "",
    "sendCodeToProvider": false
  },
  "index": {
    "dir": "",
    "maxFileKb": 256,
    "maxFiles": 5000,
    "chunkLines": 60
  },
  "security": {
    "allowedUsers": [],
    "allowedRepos": [],
    "roles": {
      "admins": [],
      "engineers": []
    },
    "maxChangesPerHour": 10,
    "maxDraftsPerHour": 20,
    "maxQuestionsPerHour": 60,
    "maxTasksPerHour": 5,
    "maxReadmeChars": 50000,
    "killSwitchFile": "./data/KILL_SWITCH",
    "protectedPaths": [
      ".git/**",
      ".github/workflows/**",
      ".env*",
      "**/secrets/**",
      "**/*.pem",
      "**/*.key"
    ],
    "maxFiles": 20,
    "maxChangedLines": 500,
    "maxFileSizeMb": 10,
    "maxRequestChars": 2000,
    "agentNetwork": "bridge",
    "checksNetwork": "none",
    "scanSecrets": true,
    "blockOnFailedChecks": true,
    "requireProtectedBranch": true
  },
  "agent": {
    "maxTurns": 15,
    "planningBudget": 20000,
    "implementationBudget": 80000,
    "planTimeoutS": 300,
    "implementTimeoutS": 900,
    "checkTimeoutS": 600,
    "maxConcurrentTasks": 2
  },
  "docker": {
    "image": "sarvas-sandbox:latest",
    "memoryLimit": "1g",
    "cpuLimit": "1.0",
    "pidsLimit": 128
  },
  "repos": {
    "myorg/myrepo": {
      "defaultBranch": "main",
      "lintCommand": "",
      "testCommand": "",
      "extraDenyPaths": [
        "migrations/**"
      ]
    }
  }
}
