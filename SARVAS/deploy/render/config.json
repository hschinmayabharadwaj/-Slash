{
  "web": {
    "host": "0.0.0.0",
    "port": "${PORT}",
    "baseUrl": "${SARVAS_PUBLIC_URL}",
    "extraHosts": "${RENDER_EXTERNAL_HOSTNAME}",
    "sessionHours": 8,
    "dataDir": "./data",
    "clientDist": ""
  },
  "github": {
    "clientId": "${GITHUB_CLIENT_ID}",
    "clientSecret": "${GITHUB_CLIENT_SECRET}",
    "appId": "${GITHUB_APP_ID}",
    "privateKeyPath": "${GITHUB_PRIVATE_KEY_PATH}"
  },
  "agentService": {
    "addr": "127.0.0.1:8766",
    "url": "http://127.0.0.1:8766",
    "token": "${AGENT_SERVICE_TOKEN}"
  },
  "ai": {
    "provider": "gemini",
    "apiKey": "${GEMINI_API_KEY}",
    "model": "gemini-3.8-flash"
  },
  "security": {
    "allowedUsers": "${SARVAS_ALLOWED_USERS}",
    "allowedRepos": "${SARVAS_ALLOWED_REPOS}",
    "roles": {"admins": "${SARVAS_ADMINS}", "engineers": "${SARVAS_ENGINEERS}"},
    "maxChangesPerHour": 10,
    "maxDraftsPerHour": 20,
    "maxReadmeChars": 50000,
    "killSwitchFile": "./data/KILL_SWITCH"
  }
}
